<?xml version="1.0" encoding="utf-8"?>
<!-- The latest brief on the home screen (BriefWidget.kt). The background is
     an image so its colour and opacity can be set from Settings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/brief_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/brief_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/brief_widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/brief_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brief_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Brief"
                android:textColor="#EDEDF0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/brief_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="#8A8A94"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/brief_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="14"
            android:text="No brief yet. Tap to open TeleAI and write one."
            android:textColor="#C9C9D1"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/brief_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open TeleAI ›"
            android:textColor="#A3A3AD"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
